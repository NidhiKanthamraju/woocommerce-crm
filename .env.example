# Leave WOO_* empty to use data/mock_data.json
WOO_URL=https://your-store.com
WOO_KEY=ck_xxxxxxxx
WOO_SECRET=cs_xxxxxxxx

# Optional: really send emails (e.g. Mailtrap sandbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=crm@example.com

# Optional: AI email drafts (falls back to a simple template if empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: verify WooCommerce webhook signatures (use the webhook's secret)
WOO_WEBHOOK_SECRET=
